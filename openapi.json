  "components": {
    "schemas": {
      "ApprovalDecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "cancelled",
              "expired"
            ],
            "title": "Decision",
            "description": "Decision: 'approved', 'rejected', 'cancelled', or 'expired'"
          },
          "decided_by": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Decided By",
            "description": "Identity of the deciding operator"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Optional justification, feedback, or remediation note"
          },
          "evidence": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence",
            "description": "Optional structured evidence or parameter overrides"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "decided_by"
        ],
        "title": "ApprovalDecisionRequest",
        "description": "Schema for submitting a human operator approval decision."
      },
      "ApprovalResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Primary key from approvals.id"
          },
          "execution_id": {
            "type": "string",
            "format": "uuid",
            "title": "Execution Id",
            "description": "Foreign key to executions.execution_id"
          },
          "workflow_state_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workflow State Id",
            "description": "Foreign key to workflow_state.id if associated with a specific node"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "cancelled",
              "expired"
            ],
            "title": "Decision",
            "description": "Decision outcome matching approvals.decision constraint"
          },
          "decided_by": {
            "type": "string",
            "maxLength": 255,
            "title": "Decided By",
            "description": "Identity of the operator or automated service that decided"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Operator justification or explanation text"
          },
          "evidence": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence",
            "description": "Structured context or parameters evaluated during decision"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "title": "Decided At",
            "description": "Timestamp when the decision was finalized"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "execution_id",
          "decision",
          "decided_by",
          "decided_at"
        ],
        "title": "ApprovalResponse",
        "description": "Schema representing an approval record from the 'approvals' table."
      },
      "DLQEventResponse": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id",
            "description": "Unique event identifier"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload",
            "description": "Raw outbound event payload that failed processing"
          },
          "failure_reason": {
            "type": "string",
            "title": "Failure Reason",
            "description": "Reason or error message that routed the event to DLQ"
          },
          "retry_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Retry Count",
            "description": "Number of retry attempts attempted before landing in DLQ",
            "default": 0
          },
          "failed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Failed At",
            "description": "Timestamp when event was placed into the DLQ"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "payload",
          "failure_reason",
          "failed_at"
        ],
        "title": "DLQEventResponse",
        "description": "Schema representing a poisoned or retry-exhausted incident event in the DLQ."
      },
      "DLQReplayResponse": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id",
            "description": "Identifier of the event being replayed"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "replayed"
            ],
            "title": "Status",
            "description": "Replay outcome status ('accepted' or 'replayed')",
            "default": "accepted"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id",
            "description": "Correlation ID tracking the replay operation"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable result summary of the replay dispatch"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "correlation_id",
          "message"
        ],
        "title": "DLQReplayResponse",
        "description": "Response schema returned upon replaying a DLQ event."
      },
      "EvalResultResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id",
            "description": "Unique identifier of the completed evaluation run"
          },
          "dataset_name": {
            "type": "string",
            "title": "Dataset Name",
            "description": "Name of the evaluated benchmark dataset"
          },
          "benchmark_score": {
            "type": "number",
            "minimum": 0.0,
            "title": "Benchmark Score",
            "description": "Overall benchmark composite score"
          },
          "accuracy": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Accuracy",
            "description": "Evaluation accuracy score between 0.0 and 1.0"
          },
          "p95_latency_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "P95 Latency Ms",
            "description": "95th percentile inference/processing latency in milliseconds"
          },
          "completed_at": {
            "type": "string",
            "title": "Completed At",
            "description": "ISO 8601 timestamp when evaluation finished"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "dataset_name",
          "benchmark_score",
          "accuracy",
          "p95_latency_ms",
          "completed_at"
        ],
        "title": "EvalResultResponse",
        "description": "Response schema containing benchmark metrics and scores for an evaluation run."
      },
      "EvalRunRequest": {
        "properties": {
          "dataset_name": {
            "type": "string",
            "title": "Dataset Name",
            "description": "Name of the evaluation dataset or benchmark corpus"
          },
          "sample_size": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Size",
            "description": "Optional limit on the number of evaluation samples to execute"
          },
          "model_override": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Override",
            "description": "Optional model identifier override for the evaluation run"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_name"
        ],
        "title": "EvalRunRequest",
        "description": "Request schema to initiate an automated benchmark evaluation run."
      },
      "EvalRunResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id",
            "description": "Unique identifier for the initiated evaluation run"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current state of the evaluation run (e.g. 'started', 'running')"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO 8601 timestamp when evaluation run was initiated"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
