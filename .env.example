# =============================================================================
# BARQ AI Incident Resolution Platform — Environment Configuration
# =============================================================================
# Instructions:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Fill in your personal credentials (passwords, ServiceNow instance URL).
#   3. Standard local defaults (ports, DB names, models) are pre-filled below.
# =============================================================================

# -----------------------------------------------------------------------------
# Host & Network Binding (Security)
# -----------------------------------------------------------------------------
# Binds service ports to localhost (127.0.0.1) by default to prevent exposing
# database ports on local Wi-Fi / LAN.
# Override to 0.0.0.0 only if you intentionally need external device access.
BIND_IP=127.0.0.1

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=incident_knowledge_base
QDRANT_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=barq_incident_dev
POSTGRES_USER=postgres
# REQUIRED: Must be explicitly set before starting containers. Docker Compose will fail if left unset.
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Redis (Cache & Task Queue — Sprint 2+)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: Leave empty for unauthenticated local development, or provide a secret
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# FastEmbed Models
# -----------------------------------------------------------------------------
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# -----------------------------------------------------------------------------
# ServiceNow Integration
# -----------------------------------------------------------------------------
# REQUIRED: Your personal ServiceNow PDI instance URL (e.g. https://dev12345.service-now.com)
SERVICENOW_INSTANCE_URL=
# REQUIRED: ServiceNow OAuth client credentials
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
# REQUIRED: ServiceNow user credentials
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# Timeout for ServiceNow API requests in seconds
SERVICENOW_TIMEOUT_SECONDS=10
# Buffer time before token expiry to refresh the token in seconds
SERVICENOW_TOKEN_EXPIRY_BUFFER_SECONDS=30
# Target Knowledge Base sys_id
SERVICENOW_KB_ID=
