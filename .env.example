# =============================================================================
# BARQ AI Incident Resolution Platform — Environment Configuration
# =============================================================================
# Instructions:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Fill in your personal credentials (passwords, ServiceNow instance URL).
#   3. Standard local defaults (ports, DB names, models) are pre-filled below.
# =============================================================================

# -----------------------------------------------------------------------------
# Host & Network Binding (Security)
# -----------------------------------------------------------------------------
# Binds service ports to localhost (127.0.0.1) by default to prevent exposing
# database ports on local Wi-Fi / LAN.
# Override to 0.0.0.0 only if you intentionally need external device access.
BIND_IP=127.0.0.1

# -----------------------------------------------------------------------------
# Public Base URL (dev tunnel / staging override)
# -----------------------------------------------------------------------------
# The externally reachable base URL of this service.
# For local dev, set to your ngrok static domain. Leave blank in production
# (the platform URL is typically set at the load-balancer / ingress level).
PUBLIC_BASE_URL=https://motor-earlobe-snowman.ngrok-free.dev

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=incident_knowledge_base
QDRANT_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=barq_incident_dev
POSTGRES_USER=postgres
# REQUIRED: Must be explicitly set before starting containers. Docker Compose will fail if left unset.
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Redis (Cache & Task Queue — Sprint 2+)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: Leave empty for unauthenticated local development, or provide a secret
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Workers — Celery execution substrate (Task S2.3)
# -----------------------------------------------------------------------------
# Worker concurrency (prefork child processes)
WORKER_CONCURRENCY=4
# Max attempts per event before dead-lettering (also enforced by retry_state.max_attempts)
WORKER_MAX_RETRIES=5
# Exponential backoff: delay = base * 2**(attempt-1), capped at max
WORKER_BACKOFF_BASE=1.0
WORKER_BACKOFF_MAX=60.0
# Full jitter so parallel retriers do not sync up
WORKER_BACKOFF_JITTER=true
# Task time limits (s): soft raises inside the task, hard SIGKILLs the process.
# Sized for an assumed sub-90s graph run; revisit when Sprint 3 lands latency numbers.
WORKER_SOFT_TIME_LIMIT=120
WORKER_TIME_LIMIT=150
# Prefetch multiplier: 1 for long-running tasks (no job hoarding)
WORKER_PREFETCH=1
# Worker repository backend: postgres | memory (memory = tests/stand-in only)
WORKER_REPO_BACKEND=postgres

# -----------------------------------------------------------------------------
# Webhook OAuth (S1.3 outbound event -> backend, #93)
# -----------------------------------------------------------------------------
# ServiceNow requests a token from /api/v1/oauth/token with these client
# credentials, then calls the webhook with it. Set the same client secret on the
# ServiceNow OAuth provider "BARQ Webhook OAuth". The signing key signs the
# issued tokens and must be at least 32 characters; it never leaves the backend.
WEBHOOK_OAUTH_CLIENT_ID=barq-servicenow
WEBHOOK_OAUTH_CLIENT_SECRET=
WEBHOOK_OAUTH_SIGNING_KEY=

# -----------------------------------------------------------------------------
# FastEmbed Models
# -----------------------------------------------------------------------------
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# -----------------------------------------------------------------------------
# ServiceNow Integration (Least-Privilege Machine Account - Task S1.2)
# -----------------------------------------------------------------------------
# The integration user must be a dedicated least-privilege service account.
# It must hold ONLY the x_2215032_ai_inc_0.integration_writer role and must
# NEVER be admin (admin authentication is an explicit exclusion in the PRD).
SERVICENOW_INSTANCE_URL=https://dev00000.service-now.com
SERVICENOW_CLIENT_ID=your_oauth_client_id_here
SERVICENOW_CLIENT_SECRET=your_oauth_client_secret_here
SERVICENOW_USERNAME=ai_orchestrator_svc
SERVICENOW_PASSWORD=your_service_account_password_here
SERVICENOW_GRANT_TYPE=password
SERVICENOW_TIMEOUT_SECONDS=10
# Buffer time before token expiry to refresh the token in seconds
SERVICENOW_TOKEN_EXPIRY_BUFFER_SECONDS=120
# Target Knowledge Base sys_id
SERVICENOW_KB_ID=
# KB publishing identity (#91). scripts/publish_kb.py signs in as this user when
# set: the non-admin kb_publisher, holding only x_2215032_ai_inc_0.kb_publisher.
SERVICENOW_KB_USERNAME=kb_publisher
SERVICENOW_KB_PASSWORD=

# -----------------------------------------------------------------------------
# Retrieval 
# -----------------------------------------------------------------------------
# dense_only / hybrid / hybrid_reranked
# hybrid is the shipped default: the S2.4 ablation showed the cross-encoder
# adds ~12x p50 latency for no accuracy gain on this eval set (#150).
RETRIEVAL_MODE="hybrid"
RERANK_MODEL="Xenova/ms-marco-MiniLM-L-6-v2"
RERANK_TOP_K=5
RERANK_CANDIDATE_LIMIT=20  # must be larger than RERANK_TOP_K

# -----------------------------------------------------------------------------
# API authorization. Two credentials, two audiences (#136, #148):
#   * WEBHOOK_OAUTH_* -- what the ServiceNow outbound REST message exchanges at
#     POST /api/v1/oauth/token for a short-lived webhook JWT. That JWT is the
#     only thing the incident webhook accepts.
#   * WEBHOOK_AUTH_TOKEN -- the operator client's secret. Humans and scripts
#     exchange it at the same endpoint for an operator JWT, whose subject is
#     OPERATOR_CLIENT_ID and whose roles come from OPERATOR_ROLES. It is not
#     accepted as a bearer token itself, and the webhook never accepts it, so
#     the credential ServiceNow holds cannot reach /approvals, /config, /dlq,
#     /executions or /eval.
# -----------------------------------------------------------------------------
WEBHOOK_AUTH_TOKEN=
# OAuth client credentials used by the ServiceNow outbound REST message.
WEBHOOK_OAUTH_CLIENT_ID=barq-servicenow
WEBHOOK_OAUTH_CLIENT_SECRET=
# Generate at least 32 random bytes; never reuse the client secret.
WEBHOOK_OAUTH_SIGNING_KEY=
# Subject of every operator token. This is the value recorded as
# approvals.decided_by -- the body cannot override it.
OPERATOR_CLIENT_ID=barq-operator
# Roles carried in the operator token's signed "roles" claim. require_role()
# reads that claim; the X-User-Role request header is ignored.
OPERATOR_ROLES=["operator","approver"]

# -----------------------------------------------------------------------------
# Agent — LangGraph state machine (Task S2.5)
# -----------------------------------------------------------------------------
# langgraph = the eleven-node graph; stub = S2.3's simulated graph (demo/tests)
AGENT_GRAPH_BACKEND=langgraph
# postgres = checkpoints in workflow_state; memory = tests only
AGENT_CHECKPOINTER_BACKEND=postgres
# Model: Gemini through the Sprints LiteLLM proxy (programme rule: Gemini only).
# Your per-learner key; only "gemini/..." model names are allowed.
LITELLM_BASE_URL=https://management.sprints.ai/litellm
LITELLM_API_KEY=
AGENT_LLM_MODEL=gemini/gemini-3.5-flash
AGENT_DIAGNOSTIC_MODEL='gemini/gemini-3.5-flash'
AGENT_RESOLUTION_MODEL='gemini/gemini-3.5-flash'
AGENT_CRITIC_MODEL='gemini/gemini-3.8-flash'
# Per-agent model overrides (defaults to AGENT_LLM_MODEL if unset)
# AGENT_DIAGNOSTIC_MODEL=gemini/gemini-3.5-flash
# AGENT_RESOLUTION_MODEL=gemini/gemini-3.5-flash
# AGENT_CRITIC_MODEL=gemini/gemini-3.5-flash
# Multi-agent revision loop bound (0 to 5)
AGENT_MAX_REVISIONS=2
# Optional thinking level: low | medium | high (unset = model default)
# AGENT_LLM_REASONING_EFFORT=low
# BARQ manual §11.7 values — change one at a time, under change control.
AGENT_RETRIEVAL_TOP_K=5
AGENT_RETRIEVAL_THRESHOLD=0.55
AGENT_CONFIDENCE_FLOOR=0.45
AGENT_RISK_PRIORITIES=[1]
# Highest article audience the agent may quote (public | internal | restricted)
AGENT_MAX_SECURITY_LEVEL=internal
# false = dry run: the act node records what it would write to ServiceNow
AGENT_WRITE_BACK_ENABLED=true

# -----------------------------------------------------------------------------
# Tracing — Langfuse (Task S2.5)
# -----------------------------------------------------------------------------
# Tracing is off unless both keys are set; a Langfuse outage never fails a run.
TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
TRACING_SAMPLE_RATE=1.0
